      ],
      "events": [
        "control_write"
      ]
    },
    {
      "step": "Prüfung nach 4 s (Echo da)",
      "wire": [],
      "events": [
        "control_write_verified"
      ]
    },
    {
      "step": "gridSetpointW -500 gleich",
      "ok": true,
      "why": "unchanged",
      "skipped": true,
      "wire": [],
      "events": [
        "control_write_skipped"
      ]
    },
    {
      "step": "feedExcessDcPv 0 (§51)",
      "ok": true,
      "writeType": "dv_control",
      "wire": [
        "PUB W/dvhub/settings/0/Settings/CGwacs/OvervoltageFeedIn \"{\\\"value\\\":0}\" q0",
        "PUB W/dvhub/settings/0/Settings/CGwacs/PreventFeedback \"{\\\"value\\\":1}\" q0"
      ],
      "events": [
        "dv_victron_write",
        "dv_victron_write",
        "control_write"
      ]
    },
    {
      "step": "maxDischargeW -1",
      "ok": true,
      "writeType": "mqtt",
      "wire": [
        "PUB W/dvhub/settings/0/Settings/CGwacs/MaxDischargePower \"{\\\"value\\\":-1}\" q0"
      ],
      "events": [
        "control_write"
      ]
    },
    {
      "step": "minSocPct 3 (Klemme)",
      "ok": true,
      "writeType": "mqtt",
      "wire": [
        "PUB W/dvhub/settings/0/Settings/CGwacs/BatteryLife/MinimumSocLimit \"{\\\"value\\\":5}\" q0"
      ],
      "events": [
        "control_minsoc_clamped",
        "control_write"
      ]
    },
    {
      "step": "chargeCurrentA 30",
      "ok": true,
      "writeType": "mqtt",
      "wire": [
        "PUB W/dvhub/settings/0/Settings/SystemSetup/MaxChargeCurrent \"{\\\"value\\\":30}\" q0"
      ],
      "events": [
        "control_write"
      ]
    },
    {
      "step": "Prüfungen nach 4 s",
      "wire": [],
      "events": [
        "control_write_verified",
        "control_write_verified",
        "control_write_verified"
      ]
    },
    {
      "step": "gridSetpointW -800 ohne Echo",
      "ok": true,
      "writeType": "mqtt",
      "wire": [
        "PUB W/dvhub/settings/0/Settings/CGwacs/AcPowerSetPoint \"{\\\"value\\\":-800}\" q0"
      ],
      "events": [
        "control_write"
      ]
    },
    {
      "step": "Prüfung nach Mindestabstand (kein Nach-Write-Wert → R/), Keepalive-Takt",
      "wire": [
        "PUB R/dvhub/keepalive \"\"",
        "PUB R/dvhub/settings/0/Settings/CGwacs/AcPowerSetPoint \"\""
      ],
      "events": []
    },
    {
      "step": "Nachfassen nach 2 s",
      "wire": [],
      "events": [
        "control_write_verify_error"
      ]
    },
    {
      "step": "gridSetpointW -900, Gegenstelle meldet -100",
      "ok": true,
      "writeType": "mqtt",
      "wire": [
        "PUB W/dvhub/settings/0/Settings/CGwacs/AcPowerSetPoint \"{\\\"value\\\":-900}\" q0"
      ],
      "events": [
        "control_write"
      ]
    },
    {
      "step": "Prüfung nach Mindestabstand (abweichend)",
      "wire": [
        "PUB R/dvhub/keepalive \"\""
      ],
      "events": [
        "control_write_unconfirmed"
      ]
    },
    {
      "step": "gridSetpointW -900 erneut (lastWrite verworfen)",
      "ok": true,
      "writeType": "mqtt",
      "wire": [
        "PUB W/dvhub/settings/0/Settings/CGwacs/AcPowerSetPoint \"{\\\"value\\\":-900}\" q0"
      ],
      "events": [
        "control_write"
      ]
    },
    {
      "step": "gridSetpointW -1000 im Not-Halt",
      "ok": false,
      "why": "emergency_stop_active",
      "blocked": true,
      "wire": [],
      "events": [
        "control_write_blocked_nothalt"
      ]
    },
    {
      "step": "gridSetpointW -700 Broker getrennt",
      "ok": false,
      "why": "MQTT nicht verbunden",
      "wire": [],
      "events": [
        "control_write_error"
      ]
    }
  ],
