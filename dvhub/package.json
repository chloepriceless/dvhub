{
  "name": "dvhub",
  "version": "1.0.7",
  "description": "Direktvermarktungs-Schnittstelle für Victron ESS - Modbus-Proxy und DVhub Leitstand",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN ../LICENSE.md",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "pretest": "eslint .",
    "test": "node ../tests/node-version-drift.mjs && node ../tests/run-node-tests.mjs --test-timeout=60000 test/*.test.js test/api/*.test.js test/migrations/*.test.js && node ../tests/binding-contract.mjs && node ../tests/csp-lint.mjs && node ../tests/css-tokens.test.mjs && node ../tests/endpoint-inventory.mjs --verify && node ../tests/sudoers-drift.mjs && node --test ../test/*.test.js",
    "test:sqlite": "node ../tests/run-node-tests.mjs --experimental-sqlite --test-timeout=60000 test/sqlite/*.test.js",
    "test:all": "node --experimental-sqlite --test --test-timeout=60000",
    "test:e2e": "node -e \"require('fs').existsSync('../tests/node_modules') || require('fs').symlinkSync('../dvhub/node_modules','../tests/node_modules','dir')\" && playwright test --config ../tests/playwright.config.mjs",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chloepriceless/dvhub"
  },
  "keywords": [
    "victron",
    "modbus",
    "mqtt",
    "direktvermarktung",
    "solar",
    "energy",
    "ess",
    "epex"
  ],
  "dependencies": {
    "@dsnp/parquetjs": "^1.8.8",
    "aedes": "^1.2.0",
    "franc": "^6.2.0",
    "highs": "^1.15.3",
    "mqtt": "^5.16.1",
    "multicast-dns": "^7.2.5",
    "p-retry": "^8.0.1",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "prom-client": "^15.1.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  }
}
