{
  "name": "dvhub",
  "version": "0.8.0",
  "description": "Direktvermarktungs-Schnittstelle für Victron ESS - Modbus-Proxy und DVhub Leitstand",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN ../LICENSE.md",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js test/api/*.test.js test/migrations/*.test.js && node ../tests/binding-contract.mjs && node ../tests/csp-lint.mjs && node ../tests/css-tokens.test.mjs && node ../tests/endpoint-inventory.mjs --verify && node ../tests/sudoers-drift.mjs",
    "test:sqlite": "node --experimental-sqlite --test test/sqlite/*.test.js",
    "test:all": "node --experimental-sqlite --test",
    "test:e2e": "node -e \"require('fs').existsSync('../tests/node_modules') || require('fs').symlinkSync('../dvhub/node_modules','../tests/node_modules','dir')\" && playwright test --config ../tests/playwright.config.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chloepriceless/dvhub"
  },
  "keywords": [
    "victron",
    "modbus",
    "mqtt",
    "direktvermarktung",
    "solar",
    "energy",
    "ess",
    "epex"
  ],
  "dependencies": {
    "@dsnp/parquetjs": "^1.8.7",
    "aedes": "^0.51.3",
    "franc": "^6.2.0",
    "highs": "^1.8.0",
    "mqtt": "^5.10.0",
    "multicast-dns": "^7.2.5",
    "p-retry": "^8.0.0",
    "pg": "^8.13.0",
    "pg-cursor": "^2.19.0",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
