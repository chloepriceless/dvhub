    },
    "Die Handy-App ist in DVhub ausgeschaltet." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The phone app is turned off in DVhub."
          }
        }
      }
    },
    "Diese Art von Regel lässt sich in der App nicht anlegen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This kind of rule cannot be created in the app."
          }
        }
      }
    },
    "Diese Regel verwaltet DVhub selbst. In der App lässt sie sich nur ein- und ausschalten." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DVhub manages this rule itself. In the app it can only be switched on and off."
