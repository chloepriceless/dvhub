        }
      }
    },
    "Dieser QR-Code ist schon verbraucht oder abgelaufen. Bitte in DVhub einen neuen erzeugen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This QR code has already been used or has expired. Please create a new one in DVhub."
          }
        }
      }
    },
    "Dieses Gerät darf das nicht. Die Freigabe „Steuern“ vergibst du in DVhub unter „Handy-App“." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device is not allowed to do that. You grant “Control” in DVhub under “Mobile app”."
          }
        }
      }
    },
    "Dieses Gerät darf nicht steuern. In DVhub unter „Handy-App“ freigeben." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
