    "Alles wieder normal" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything back to normal"
          }
        }
      }
    },
    "Anlage nicht verbunden" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System not connected"
          }
        }
      }
    },
    "Anmeldung abgelehnt. Bitte neu koppeln." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign-in rejected. Please pair again."
          }
        }
      }
    },
    "Beendet – der Not-Halt ist aktiv, DVhub steuert die Wallbox erst nach dem Aufheben wieder." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ended – the emergency stop is active; DVhub controls the wallbox again only after it is lifted."
          }
        }
      }
    },
    "Beendet, aber die Wallbox meldet: %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ended, but the wallbox reports: %@."
          }
        }
      }
    },
    "Beendet. Es gilt wieder der Plan von EOS." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ended. The EOS plan applies again."
          }
        }
      }
    },
    "Beginn und Ende dürfen nicht gleich sein." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start and end must not be the same."
          }
        }
      }
    },
    "Bitte Beginn und Ende als Uhrzeit angeben." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please enter start and end as times."
          }
        }
      }
    },
    "Bitte die Uhrzeiten vollständig angeben." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please enter the times completely."
          }
        }
      }
    },
    "Bitte einen Wochentag wählen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please choose a weekday."
          }
        }
      }
    },
    "Dafür braucht DVhub eine Pro-Lizenz." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This needs a Pro licence in DVhub."
          }
        }
      }
    },
    "Das Relay hat die Verbindung begrenzt. Gleich erneut." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The relay limited the connection. Trying again shortly."
          }
        }
      }
    },
    "Das Relay ist gerade ausgelastet. Gleich erneut." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The relay is busy right now. Trying again shortly."
          }
        }
      }
    },
    "Das Relay startet neu." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The relay is restarting."
          }
        }
      }
    },
    "Der Ladestand muss zwischen 0 und 100 % liegen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The charge level must be between 0 and 100%."
          }
        }
      }
    },
    "Der Not-Halt ist aktiv – „Laden stoppen“ bleibt bis zum Aufheben bestehen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The emergency stop is active – “Stop charging” stays in place until it is lifted."
          }
        }
      }
    },
    "Der Wert liegt außerhalb des erlaubten Bereichs (höchstens %lld)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The value is outside the allowed range (at most %lld)."
          }
        }
      }
    },
    "Der Wochenplan hat sich inzwischen geändert. Bitte noch einmal ansehen und dann speichern." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The weekly plan has changed in the meantime. Please check it again and then save."
          }
        }
      }
    },
    "Der Zeitplan hat sich inzwischen geändert. Bitte neu laden und noch einmal versuchen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The schedule has changed in the meantime. Please reload and try again."
          }
        }
      }
    },
    "Die Anlage hat abgelehnt (HTTP %@)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
