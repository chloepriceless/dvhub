# Runtime / Secrets
dv-control-webapp/config.json
dv-control-webapp/energy_state.json
# A-3 (Go-Live-Review 2026-06-10): the app persists day-energy counters to
# ${DV_DATA_DIR}/energy_state.json, but with no DV_DATA_DIR it falls back to the
# app dir and overwrites the in-repo file — a tracked runtime file makes the tree
# dirty and breaks the `git checkout`-based self-update. Keep it out of git.
dvhub/energy_state.json
# Local diagnostic scratch files (background-flow probes, ad-hoc screenshots).
dvhub/diag-*.mjs
dvhub/diag-*.png

# Node
node_modules/
npm-debug.log*
package-lock.json

# OS
.DS_Store
Thumbs.db
docs/plans/

# IDE / Tools
.claude/
.vscode/
.worktrees/
*.swp
*.swo
*~

# Temp
tmp/
*.tmp

# Python bytecode caches (py_compile / pytest)
__pycache__/
*.pyc

# Playwright e2e artifacts (test-results/ holds traces/screenshots per run)
test-results/
playwright-report/

# Secrets (Plan 08-05 Task 3 — REPOLENS security/secrets/002-003)
# Keep operator-local config and key material out of git under any path.
config.json
dvhub/config.json
.env
.env.*
*.pem
*.key
*.p12
*.pfx
# migration-runner.js writes timestamped backups alongside config.json
config.backup-*.json
dvhub/config.backup-*.json
# Setup-wizard bootstrap token (server.js writes this at boot when needsSetup=true)
dvhub/bootstrap.token
eos-vendor/
