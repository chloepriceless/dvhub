.env
.env.*
*.pem
*.key
*.p12
*.pfx
# migration-runner.js writes timestamped backups alongside config.json
config.backup-*.json
dvhub/config.backup-*.json
# Setup-wizard bootstrap token (server.js writes this at boot when needsSetup=true)
dvhub/bootstrap.token
eos-vendor/
