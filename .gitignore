.DS_Store
Thumbs.db
docs/plans/

# IDE / Tools
.claude/
.vscode/
.worktrees/
*.swp
*.swo
*~

# Temp
tmp/
*.tmp

# Python bytecode caches (py_compile / pytest)
__pycache__/
*.pyc

# Playwright e2e artifacts (test-results/ holds traces/screenshots per run)
test-results/
playwright-report/

# Secrets (Plan 08-05 Task 3 — REPOLENS security/secrets/002-003)
# Keep operator-local config and key material out of git under any path.
config.json
dvhub/config.json
.env
.env.*
*.pem
*.key
*.p12
*.pfx
# migration-runner.js writes timestamped backups alongside config.json
config.backup-*.json
dvhub/config.backup-*.json
# Setup-wizard bootstrap token (server.js writes this at boot when needsSetup=true)
dvhub/bootstrap.token
eos-vendor/

# Operator-seitiges Support-Werkzeug (NICHT Teil der ausgelieferten Appliance)
support-console.html

