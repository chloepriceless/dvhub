# DVhub Compose — nach docker/.env kopieren und Passwörter setzen.
# Die Datei .env gehört NICHT ins Repo.

# DB-Admin (Rolle postgres). DVhub nutzt ihn nur für Backup/Restore aus der
# Oberfläche. Lang und zufällig, z. B.: openssl rand -hex 24
DB_ADMIN_PASSWORD=

# Passwort der App-Rolle dvhub.
DVHUB_DB_PASSWORD=

# Komplette Suite inkl. EOS (Pro-Optimierer). Leer lassen = nur DVhub + DB.
COMPOSE_PROFILES=eos
EOS_TAG=dvhub-v0.4.0rc1.3
EOS_MEM_LIMIT=352m
EOS_CPUS=1

# Registry: Docker Hub (Standard) oder GitHub
# DVHUB_IMAGE=ghcr.io/chloepriceless/dvhub
# EOS_IMAGE=ghcr.io/chloepriceless/dvhub-eos

# Image-Tag: latest (letztes Release), 1.0.7, 1.0 oder dev (Vorab-Stand, kein Release)
DVHUB_TAG=latest
TIMESCALE_TAG=2.28.2-pg17

# Webport von DVhub (nur beim ersten Start in die Config übernommen)
DVHUB_HTTP_PORT=8080

# Port der DB auf 127.0.0.1 des Hosts. 5433, damit eine native Installation auf
# demselben Host (Postgres auf 5432) nicht kollidiert — z. B. beim Umzug.
DB_PORT=5433

# Speicherbudget: Obergrenzen zusammen 704 MB (DB 160 + DVhub 192 + EOS 352).
# Im Betrieb gemessen ~470–650 MB. Mit mehr RAM darf es großzügiger sein.
DB_SHARED_BUFFERS=64MB
DB_TUNE_MEMORY=256MB
DB_MEM_LIMIT=160m
DVHUB_MEM_LIMIT=192m

TZ=Europe/Berlin
