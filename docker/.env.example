# DVhub Compose — nach docker/.env kopieren und Passwörter setzen.
# Die Datei .env gehört NICHT ins Repo.

# DB-Admin (Rolle postgres). DVhub nutzt ihn nur für Backup/Restore aus der
# Oberfläche. Lang und zufällig, z. B.: openssl rand -hex 24
DB_ADMIN_PASSWORD=

# Passwort der App-Rolle dvhub.
DVHUB_DB_PASSWORD=

# Komplette Suite inkl. EOS (Pro-Optimierer). Leer lassen = nur DVhub + DB.
COMPOSE_PROFILES=eos
# EOS-Quelle: Repo + Git-Tag — das offizielle, unveränderte Akkudoktor-EOS
# (seit 2026-10-11; vorher der eigene Fork DV-EOS). Gleicher Stand wie
# eos-version.env.
EOS_REPO=https://github.com/Akkudoktor-EOS/EOS.git
EOS_TAG=v0.4.0rc3
# EOS-Image: v0.4.0rc3 ist ein Vorab-Stand, den Akkudoktor nicht als Image
# veröffentlicht — deshalb bikinibottomcapital/dvhub-eos:<EOS_TAG>, von unserer
# CI aus genau diesem Tag gebaut. Sobald der Pin auf ein EOS-Release zeigt, das
# offizielle Image eintragen (die CI baut dann nichts mehr und weist darauf hin):
# EOS_IMAGE=docker.io/akkudoktor/eos
# EOS_IMAGE_TAG=0.4.0
EOS_MEM_LIMIT=320m
# CPU-Kontingent für EOS in Kernen, 0 = keins (EOS pinnt seine Rechenprozesse
# selbst auf höchstens 2 Kerne und lässt immer einen frei).
EOS_CPUS=0

# Registry: Docker Hub (Standard) oder GitHub
# DVHUB_IMAGE=ghcr.io/chloepriceless/dvhub
# EOS_IMAGE=ghcr.io/chloepriceless/dvhub-eos   (nur der Eigenbau ist gespiegelt)

# Image-Tag: latest (letztes Release), 1.0.7, 1.0 oder dev (Vorab-Stand, kein Release)
DVHUB_TAG=latest
TIMESCALE_TAG=2.30.2-pg17
# Schlankes Datenbank-Image für schwache Geräte (SPiNE EnergyLink, ~200 MB statt
# ~1,5 GB, nur die ausgelieferten TimescaleDB-Versionen — docker/timescaledb-slim):
# TIMESCALE_IMAGE=docker.io/bikinibottomcapital/timescaledb-slim

# Webport von DVhub (nur beim ersten Start in die Config übernommen)
DVHUB_HTTP_PORT=8080

# Port der DB auf 127.0.0.1 des Hosts. 5433, damit eine native Installation auf
# demselben Host (Postgres auf 5432) nicht kollidiert — z. B. beim Umzug.
DB_PORT=5433

# Speicherbudget: Obergrenzen zusammen 704 MB (DB 160 + DVhub 192 + EOS 352).
# Im Betrieb gemessen ~470–650 MB. Mit mehr RAM darf es großzügiger sein.
DB_SHARED_BUFFERS=64MB
DB_TUNE_MEMORY=256MB
DB_MEM_LIMIT=224m
DVHUB_MEM_LIMIT=192m

TZ=Europe/Berlin
